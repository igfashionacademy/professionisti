# Copy to .env (or .env.production) and fill in. These values are embedded
# into the PUBLIC website, so only put browser-safe keys here.
#
# NEVER put the Supabase service_role / sb_secret_ key or ADMIN_PASSPHRASE here.
# Those live only in the Edge Function secrets (supabase secrets set ...).

# Supabase project URL (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co/
# Publishable (anon) key: starts with sb_publishable_ (or the legacy "anon" JWT)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Google Maps browser key (Places API New). Restrict it by HTTP referrer to your domain.
# Leave empty to disable address autocomplete.
VITE_GOOGLE_MAPS_KEY=
